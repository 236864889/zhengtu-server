{"path": "ztgame/tools/CollectServerInfo.cpp", "module": "tools_ops_collect", "domain": "tools", "recommended_collection": "ztgame_server_tools_ops", "keywords": ["proc", "cpu", "net", "xml"], "reason": "系统信息采集细节来源", "content_preview": "/**\n * \\file\n * \\version  $Id: CollectServerInfo.cpp  $\n * \\author  \n * \\date \n * \\brief �����ռ���������Ϣ��\n */\n\n#include <errno.h>\n#include <error.h>\n#include <pthread.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <sys/sysinfo.h>\n#include <sys/utsname.h>\n/////////////////////\n/////////////////////\n#include <unistd.h>\n#include <sys/types.h>\n#include <dirent.h>\n\n#include \"CollectServerInfo.h\"\n#include \"zTime.h\"\n#include \"zXMLParser.h\"\n\n/**\n * \\brief ��ȡ������������Ϣ\n * ��Щ��Ϣ����������Ϣ���ڴ���Ϣ��CPU��Ϣ��ϵͳ��Ϣ�Լ�������Ϣ\n * ����xml��ʽ�����һ�����ݻ���\n */\nvoid ServerInfo::getServerInfo(std::string &xmlStr)\n{\n\tzXMLParser xml;\n\txmlNodePtr root, node, snode;\n\tchar buffer[512];\n\tif (xml.init()\n\t\t\t&& NULL != (root = xml.newRootNode(\"Server\")))\n\t{\n\t\tnode = xml.newChildNode(root, \"SYS\", NULL);\n\t\tif (node)\n\t\t{\n\t\t\tstruct utsname uts;\n\t\t\tif (0 == uname(&uts))\n\t\t\t{\n\t\t\t\txml.newNodeProp(node, \"sysname\", uts.sysname);\n\t\t\t\txml.newNodeProp(node, \"nodename\", uts.nodename);\n\t\t\t\txml.newNodeProp(node, \"release\", uts.release);\n\t\t\t\txml.newNodeProp(node, \"version\", uts.version);\n\t\t\t\txml.newNodeProp(node, \"machine\", uts.machine);\n\t\t\t\txml.newNodeProp(node, \"domainname\", uts.domainname);"}
